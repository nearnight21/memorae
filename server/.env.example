# Memorae Server local environment. The server does not load this file
# automatically; inject it into the process that starts the server.

# JSON local mode (use this instead of MEMORY_RECALL_DATABASE_URL).
MEMORY_RECALL_LOCAL_TOKEN=
MEMORY_RECALL_DATA_FILE=.local-data/store.json
MEMORY_RECALL_ALLOWED_ORIGINS=http://127.0.0.1:3000
MEMORY_RECALL_PORT=8788
MEMORY_RECALL_AMAP_WEB_SERVICE_KEY=

# PostgreSQL mode (omit MEMORY_RECALL_LOCAL_TOKEN when using this mode).
MEMORY_RECALL_DATABASE_URL=
MEMORY_RECALL_SESSION_TOKEN_PEPPER=
MEMORY_RECALL_LISTEN_HOST=0.0.0.0

# Private COS photo storage. Set all four together or leave all four empty.
MEMORY_RECALL_COS_BUCKET=
MEMORY_RECALL_COS_REGION=
MEMORY_RECALL_COS_SECRET_ID=
MEMORY_RECALL_COS_SECRET_KEY=

# One-time invited-account administration; never keep these in a normal env file.
MEMORY_RECALL_INVITED_LOGIN=
MEMORY_RECALL_INVITED_PASSWORD=

# PostgreSQL integration tests only; must point to a disposable test database.
MEMORY_RECALL_TEST_DATABASE_URL=

# Deployment control-plane values (used by server/deploy/compose.yaml only).
MEMORY_RECALL_POSTGRES_PASSWORD=
MEMORY_RECALL_API_BIND_HOST=127.0.0.1
MEMORY_RECALL_API_PORT=8788
MEMORY_RECALL_PUBLIC_DOMAIN=
CADDY_EMAIL=
