# Generate all passwords and peppers with a password manager. Do not commit .env.
MEMORY_RECALL_POSTGRES_PASSWORD=replace-with-a-random-database-password
# URL-encode reserved characters in the password portion of this URL.
MEMORY_RECALL_DATABASE_URL=postgresql://memory_recall:replace-with-a-url-encoded-password@postgres:5432/memory_recall
MEMORY_RECALL_SESSION_TOKEN_PEPPER=replace-with-a-random-32-plus-character-token-pepper
MEMORY_RECALL_ALLOWED_ORIGINS=https://app.example.cn

# Required only when starting the public Caddy profile.
MEMORY_RECALL_PUBLIC_DOMAIN=sync.example.cn
CADDY_EMAIL=ops@example.cn

# Set all four values to enable private Tencent COS photo content storage.
MEMORY_RECALL_COS_BUCKET=
MEMORY_RECALL_COS_REGION=
MEMORY_RECALL_COS_SECRET_ID=
MEMORY_RECALL_COS_SECRET_KEY=
