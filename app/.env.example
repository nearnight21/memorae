# Memorae App environment contract. This file contains no usable credentials.
# EXPO_PUBLIC_* values are embedded in the client bundle and are not secrets.

# App runtime. Empty API URL uses the app's current production default.
EXPO_PUBLIC_MEMORY_RECALL_API_URL=

# AMap client credentials. Restrict them by package/signature or allowed origin.
MEMORY_RECALL_AMAP_ANDROID_KEY=
EXPO_PUBLIC_AMAP_WEB_KEY=
EXPO_PUBLIC_AMAP_WEB_SECURITY_CODE=

# Development-only isolated map entries. Keep disabled in production builds.
EXPO_PUBLIC_AMAP_WEBVIEW_SLICE=0
EXPO_PUBLIC_AMAP_VERTICAL_SLICE=0
EXPO_PUBLIC_AMAP_WEBVIEW_DEBUG=0
EXPO_PUBLIC_MEMORAE_MAP_RENDERER=webview
EXPO_PUBLIC_TIMELINE_PROTOTYPE=0
EXPO_PUBLIC_MEMORAE_NATIVE_AMAP_PRIVACY_CONSENT=0

# Android release signing. Do not store real values in app/.env.local.
# Load the unique credentials from D:\hermes\secure\memorae\ into the release
# build process or an approved CI/EAS credential store.
MEMORY_RECALL_ANDROID_KEYSTORE_PATH=
MEMORY_RECALL_ANDROID_STORE_PASSWORD=
MEMORY_RECALL_ANDROID_KEY_ALIAS=
MEMORY_RECALL_ANDROID_KEY_PASSWORD=

# CI/EAS authentication is never committed; set it only in the CI/EAS secret store.
# EXPO_TOKEN=
